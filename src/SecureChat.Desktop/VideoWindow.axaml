<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SecureChat.Desktop.Views"
        x:Class="SecureChat.Desktop.VideoWindow"
  Width="1420"
  Height="900"
  MinWidth="1180"
  MinHeight="760"
        Title="SecureChat | 视频通话"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource WindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Border Classes="card" Background="{StaticResource SurfaceBrush}" Padding="20">
      <StackPanel Spacing="6">
        <TextBlock Text="视频通话窗口" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="视频能力、设备枚举和媒体链路放在独立窗口里，主页只保留入口和摘要。"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,18,0,18" ColumnDefinitions="1.75*,1.05*">
      <views:RemoteVideoPlayerView Margin="0,0,18,0" />
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <views:VideoCallPanelView />
          <views:OnlineUsersPanelView />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <views:FooterStatusView Grid.Row="2" />
  </Grid>
</Window>