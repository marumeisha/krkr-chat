<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SecureChat.Desktop.Views"
        x:Class="SecureChat.Desktop.LiveHostWindow"
        Width="1480"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Title="SecureChat | 主播模块"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource WindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Border Classes="card" Background="{StaticResource SurfaceBrush}" Padding="20">
      <StackPanel Spacing="6">
        <TextBlock Text="主播模块" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="这里专门处理开播、推流预览、房间状态和主播侧动态；不再和观众的选房入口混在同一个窗口。"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <views:LiveHostPageView Grid.Row="1" Margin="0,18,0,18" />

    <views:FooterStatusView Grid.Row="2" />
  </Grid>
</Window>