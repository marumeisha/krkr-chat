<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SecureChat.Desktop.Views"
             x:Class="SecureChat.Desktop.Views.OnlineUsersPanelView">
  <Border Classes="card">
    <Grid RowDefinitions="Auto,*">
      <TextBlock Classes="section-title" Text="在线用户" />
      <ListBox Grid.Row="1"
               Margin="0,12,0,0"
               ItemsSource="{Binding OnlineUsers}"
               SelectedItem="{Binding SelectedOnlineUser}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <views:OnlineUserCardView />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>