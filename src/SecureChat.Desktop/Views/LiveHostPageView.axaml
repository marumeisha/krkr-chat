<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SecureChat.Desktop.Views.LiveHostPageView">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="1.6*,1.02*" Margin="0,0,6,0">
      <StackPanel Spacing="16">
        <Border Classes="card"
                Background="#FF08141D"
                BorderBrush="#334DD0C8"
                BorderThickness="1"
                CornerRadius="28"
                Padding="18">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6">
                <TextBlock Text="主播控制台" FontSize="14" FontWeight="Bold" Foreground="#6EE7D8" />
                <TextBlock Text="{Binding ActiveLiveRoomDisplayName}" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="{Binding LiveRoomHeroHintText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Margin="12,0,0,0"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Top">
                <Border Background="#E6223A5F" CornerRadius="999" Padding="12,6">
                  <TextBlock Text="{Binding LiveRoomRoleBadgeText}" FontWeight="Bold" />
                </Border>
                <Button Content="离开房间"
                        Command="{Binding LeaveLiveRoomCommand}"
                        IsEnabled="{Binding IsLiveRoomActive}" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Background="#FF020A0E"
                    CornerRadius="24"
                    ClipToBounds="True"
                    MinHeight="520">
              <Grid>
                <Image Source="{Binding LiveRoomVideoFrame}" Stretch="UniformToFill" />
                <Border Background="#26020A0E" />

                <StackPanel Margin="22"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Spacing="10">
                  <Border Background="#A5D04E2C" CornerRadius="999" Padding="12,6">
                    <TextBlock Text="直播推流中" FontWeight="Bold" />
                  </Border>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#A8142028" CornerRadius="999" Padding="12,6">
                      <TextBlock Text="{Binding ActiveLiveRoomViewerCountText}" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#A8142028" CornerRadius="999" Padding="12,6">
                      <TextBlock Text="{Binding ActiveLiveRoomHostText}" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                </StackPanel>

                <Border Margin="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="#C20A171C"
                        CornerRadius="18"
                        Padding="16,12">
                  <StackPanel Spacing="4" MaxWidth="480">
                    <TextBlock Text="{Binding LiveRoomRoleSummaryText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LiveRoomStatusText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="1.04*,0.96*" Margin="0,16,0,0">
              <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="开播设置" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="主播页只保留推流相关操作和状态，不再和观众的选房目录混在同一个面板里。"
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                  <TextBox Watermark="给直播间取个名字（可选）"
                           Text="{Binding LiveRoomName}" />
                  <TextBox Watermark="当前房间号"
                           Text="{Binding LiveRoomCodeInput}" />
                  <Grid ColumnDefinitions="*,*">
                    <Button Content="创建公开直播房间"
                            Command="{Binding CreateLiveRoomCommand}" />
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="刷新房间目录"
                            Command="{Binding RefreshLiveRoomsCommand}" />
                  </Grid>
                  <TextBlock Text="{Binding ActiveLiveRoomText}"
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      Margin="16,0,0,0"
                      Background="{StaticResource SurfaceBrush}"
                      CornerRadius="18"
                      Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="直播动态" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="{Binding LiveRoomDirectoryStatusText}"
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding LiveRoomStages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                          <Run Text="•  " />
                          <Run Text="{Binding}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="16">
        <Border Classes="card" Background="{StaticResource SurfaceBrush}" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="房间信息" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding ActiveLiveRoomDisplayName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveLiveRoomHostText}" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="{Binding ActiveLiveRoomViewerCountText}" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="{Binding LiveRoomRoleSummaryText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Background="{StaticResource SurfaceBrush}" Padding="16">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="设备选择" FontSize="20" FontWeight="Bold" />
              <Button Grid.Column="1"
                      Content="刷新设备"
                      Command="{Binding RefreshVideoDevicesCommand}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,*"
                  RowDefinitions="Auto,Auto,Auto">
              <TextBlock Text="视频输入"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" />
              <ComboBox Grid.Column="1"
                        Margin="12,0,0,0"
                        ItemsSource="{Binding VideoInputModes}"
                        SelectedItem="{Binding SelectedVideoInputMode}" />
              <TextBlock Grid.Column="2"
                         Margin="14,0,0,0"
                         Text="摄像头"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" />
              <ComboBox Grid.Column="3"
                        Margin="12,0,0,0"
                        ItemsSource="{Binding CameraDevices}"
                        SelectedItem="{Binding SelectedCameraDevice}"
                        IsEnabled="{Binding IsCameraInputSelected}" />

              <TextBlock Grid.Row="1"
                         Margin="0,12,0,0"
                         Text="共享目标"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" />
              <ComboBox Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,12,0,0"
                        ItemsSource="{Binding ScreenCaptureTargets}"
                        SelectedItem="{Binding SelectedScreenCaptureTarget}"
                        IsEnabled="{Binding IsScreenInputSelected}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="2"
                         Margin="14,12,0,0"
                         Text="预览高度"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" />
              <Slider Grid.Row="1"
                      Grid.Column="3"
                      Margin="12,12,0,0"
                      Minimum="320"
                      Maximum="720"
                      Value="{Binding VideoViewportHeight}"
                      TickFrequency="20" />

              <TextBlock Grid.Row="2"
                         Text="麦克风"
                         Margin="0,12,0,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" />
              <ComboBox Grid.Row="2"
                        Grid.Column="1"
                        Margin="12,12,0,0"
                        ItemsSource="{Binding MicrophoneDevices}"
                        SelectedItem="{Binding SelectedMicrophoneDevice}" />
              <CheckBox Grid.Row="2"
                        Grid.Column="2"
                        Margin="18,12,0,0"
                        VerticalAlignment="Center"
                        Content="混入系统音频"
                        IsChecked="{Binding MixSystemAudioEnabled}" />
              <ComboBox Grid.Row="2"
                        Grid.Column="3"
                        Margin="12,12,0,0"
                        ItemsSource="{Binding SystemAudioDevices}"
                        SelectedItem="{Binding SelectedSystemAudioDevice}"
                        IsEnabled="{Binding MixSystemAudioEnabled}" />
            </Grid>

            <Border Background="#14000000" CornerRadius="14" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="热切换说明" FontWeight="SemiBold" />
                <TextBlock Text="主播模块现在和视频通话使用同一套设备选择能力，推流过程中直接切换即可立即生效。"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding CameraSelectionText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding ScreenCaptureSelectionText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding AudioInputSelectionText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
            </Border>

            <Border Background="#14000000" CornerRadius="14" Padding="14">
              <StackPanel Spacing="12">
                <TextBlock Text="推流质量" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="Auto,120,Auto,120" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="音频码率"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMutedBrush}" />
                  <ComboBox Grid.Column="1"
                            Margin="12,0,0,0"
                            ItemsSource="{Binding AudioBitrateOptionsKbps}"
                            SelectedItem="{Binding SelectedAudioBitrateKbps}" />
                  <TextBlock Grid.Column="2"
                             Margin="18,0,0,0"
                             Text="摄像头码率"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMutedBrush}" />
                  <ComboBox Grid.Column="3"
                            Margin="12,0,0,0"
                            ItemsSource="{Binding CameraBitrateOptionsKbps}"
                            SelectedItem="{Binding SelectedCameraBitrateKbps}" />

                  <TextBlock Grid.Row="1"
                             Margin="0,12,0,0"
                             Text="摄像头帧率"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMutedBrush}" />
                  <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            Margin="12,12,0,0"
                            ItemsSource="{Binding CameraFrameRateOptions}"
                            SelectedItem="{Binding SelectedCameraFrameRate}" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="2"
                             Margin="18,12,0,0"
                             Text="屏幕码率"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMutedBrush}" />
                  <ComboBox Grid.Row="1"
                            Grid.Column="3"
                            Margin="12,12,0,0"
                            ItemsSource="{Binding ScreenShareBitrateOptionsKbps}"
                            SelectedItem="{Binding SelectedScreenShareBitrateKbps}" />

                  <TextBlock Grid.Row="2"
                             Margin="0,12,0,0"
                             Text="屏幕帧率"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMutedBrush}" />
                  <ComboBox Grid.Row="2"
                            Grid.Column="1"
                            Margin="12,12,0,0"
                            ItemsSource="{Binding ScreenShareFrameRateOptions}"
                            SelectedItem="{Binding SelectedScreenShareFrameRate}" />
                </Grid>
                <TextBlock Text="{Binding MediaQualitySelectionText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" Background="{StaticResource SurfaceBrush}" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="公开房间快照" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="主播页保留目录只用于查看当前公开房间状态，不承担观众入场操作。"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding PublicLiveRooms}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10"
                          Padding="14"
                          Background="#14000000"
                          BorderBrush="#1DFFFFFF"
                          BorderThickness="1"
                          CornerRadius="14">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                      <TextBlock Text="{Binding RoomId, StringFormat=房间号: {0}}"
                                 Foreground="{StaticResource TextMutedBrush}" />
                      <TextBlock Text="{Binding ViewerCount, StringFormat={}{0} 人观看}"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>