<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SecureChat.Desktop.Views.OnlineUserCardView">
  <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding UserId}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding PresenceSummary}" Foreground="{StaticResource TextMutedBrush}" />
    </StackPanel>
  </Border>
</UserControl>